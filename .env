# /llm-services/.env
# 임베딩을 sentence-transformers로 사용
EMBEDDING_BACKEND=sentence
# 다국어(한/영) 잘 되는 가벼운 기본값 추천
EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base
TOP_K=5
DATA_DIR=./data
INDEX_DIR=./index/faiss
VECTORSTORE_BACKEND=faiss

# hugging face 로컬 폴더를 쓸 때
BACKEND=hf
MODEL_PATH=models/your-hf-model
# gguf 파일을 쓸 때
BACKEND=llama_cpp
MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
